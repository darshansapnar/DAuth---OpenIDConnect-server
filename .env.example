# Auth Server Configuration
PORT=3001
ISSUER="http://localhost:3001"
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Session and Security Secrets
SESSION_SECRET="your-super-secure-session-secret-change-in-production"

# Client Application URLs
DASHBOARD_URL="http://localhost:5173"
SAMPLE_CLIENT_URL="http://localhost:5174"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3001"

# Google Identity Federation Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/federation/google/callback"
